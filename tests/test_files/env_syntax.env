# Copied straight from a .env.example
PLAIN
EMPTY_DEFAULT=
WITH_VALUE=some value
export EXPORTED=1
QUOTED="contains # a hash"
INLINE=value # trailing comment
BARE # note about BARE
MULTILINE="first line
LOOKS_LIKE_A_NAME
last line"
SINGLE_QUOTED='one
two'
BACKTICKED=`one line`
dotted.name-with-dash=ok
